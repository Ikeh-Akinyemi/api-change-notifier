# project settings page in the trigger.dev dashboard
TRIGGER_PROJECT_REF=proj_xxxxxxxxxxxxxxxxxxxx

# fine-grained token from the account that owns the repo, read/write on contents and pull requests
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# onboarding@resend.dev is fine for testing, use your own verified domain for anything real
EMAIL_FROM=Murmurly API <onboarding@resend.dev>

# optional
# SPEC_PATH=openapi.yaml
# GUIDE_PATH=docs/migration-guide.md
# APPROVAL_TIMEOUT=7d
# USAGE_WINDOW_DAYS=30
# NOTIFIER_MODEL=claude-sonnet-5-5
# NOTE_SUBJECT=Action needed: a Murmurly API update affects your calls
# GITHUB_API_URL=https://github.example.com/api/v3
